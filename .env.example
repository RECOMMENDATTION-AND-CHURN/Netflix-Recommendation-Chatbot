# ---- Required for chat / recommendations to work ----
GEMINI_API_KEY=AQ.Ab8RN6Lh7Qhb3XWYH5VfHhYODql91BkjDNn_UaE46_pCH6APNw
TMDB_API_KEY=d829ad71eb7cd96ce4dadafb0d493939

# ---- Flask web app (Module 1) ----
# A long random string. Required for sessions to survive a server restart.
NETFLIC_SECRET_KEY=
PORT=5000
FLASK_DEBUG=1

# ---- Rate limiting ----
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
CHAT_RATE_LIMIT_COOLDOWN_SECONDS=1.5

# ---- Input validation ----
CHAT_MESSAGE_MAX_LENGTH=2000
USERNAME_MIN_LENGTH=3
PASSWORD_MIN_LENGTH=6

# ---- Automatic database backup ----
DB_BACKUP_ENABLED=true
DB_BACKUP_MAX_KEEP=14
DB_BACKUP_MIN_INTERVAL_HOURS=24

# ---- Logging ----
LOG_LEVEL=INFO
LOG_TO_FILE=true
